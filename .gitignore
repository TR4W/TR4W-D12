*.nsi
*.pos
*.ini
# RAD Studio's "previous version" copy, saved beside the unit as NAME~.EXT.
# The old pattern here was `*~pas` -- no dot -- so it never matched LOGSUBS2~.PAS
# and four such files were committed.  Match the tilde before the extension, and
# match a trailing tilde too (PostUnit.PAS~, uCommctrl.pas~).
*~.*
*~
*.bak
# Knowledge-graph output (graphify): regenerated on demand, ~5 MB of JSON.
graphify-out/
# Delphi compiler-generated binaries (safe to delete)
*.exe
*.dll
*.bpl
*.bpi
*.dcp
*.so
*.apk
*.drc
*.map
*.dres
*.rsm
*.tds
*.dcu
*.lib

# Delphi autogenerated files (duplicated info)
*.cfg
*Resource.rc

# Delphi local files (user-specific info)
*.local
*.identcache
*.projdata
*.tvsconfig
*.dsk
*.dsm

# Delphi history and backups
__history/
# RAD Studio's crash-recovery copies, same class as __history: editor state,
# not source.  Committed by accident in 75ce5a60 via `git add <dir>`.
__recovery/
*.~*
# The IDE's previous-version copy, rewritten on every save.  One of these
# (LOGRADIO.$$$) was tracked and showed as modified forever, with 600-line
# diffs that were pure noise against the .PAS beside it.
*.$$$

# Castalia statistics file
*.stat.gitignore

*.ini
tr4w/target/tr4w.exe
tr4w/target/settings/TR4W.INI
*.pos
*.CFG
*.map
tr4w/target/tr4w.map
tr4w/target/tr4w-debug.log
tr4w/target/tr4w.log
# Ignore everything in target/ but allow specific tracked subdirectories/files.
# Must use tr4w/target/* (not tr4w/target/) so git descends into the directory
# and honours the negation rules below. A trailing-slash ignore pattern causes
# git to skip the directory entirely, making negations inside it ineffective.
#
# cty.dat note: the file IS tracked in master (so fresh clones get a working
# copy), but it is intentionally NOT re-included via negation here.  TR4W
# rewrites cty.dat at runtime; we no longer want those local edits to surface
# in `git status` or be accidentally committed.  Each developer should also
# run `git update-index --skip-worktree tr4w/target/cty.dat` once locally to
# fully silence cty.dat from status.  If the master copy ever genuinely needs
# updating, `git add -f tr4w/target/cty.dat` bypasses this ignore.
tr4w/target/*
!tr4w/target/dom
!tr4w/target/trcluster.dat
!tr4w/target/commands*.ini
tr4w/tr4w.cfg
tr4w/tr4w.dof
# Generated each build by FullBuild.ps1 Write-VersionInfoResource: a
# language- and version-specific VERSIONINFO PE resource picked up by
# tr4w.dpr via {$IFDEF VERSIONINFO_RES}{$R tr4w_versioninfo.res}{$ENDIF}.
# Files never need to be tracked -- always regenerated.
tr4w/tr4w_versioninfo.rc
tr4w/tr4w_versioninfo.res
tr4w/COMPILER.LOG
tr4w/tr4w.log
*.RST
*.TRW
*.LOG

# Build output text files
tr4w/build_*.txt
tr4w/COMPILATION_RESULTS.txt
tr4w/compile_*.txt
tr4w/tr4w.log.*
tr4w/build_*.log

# Claude Code local config and memory
.claude/
tr4w/.claude/

# Network capture files (local debugging only)
*.pcap
*.pcapng

# GitHub Wiki — separate repo at n4af/TR4W.wiki.git, cloned locally for editing
wiki/
pcap/
spike/units/
spike/units_indy/
spike/*.exe
spike/*.o
spike/*.ppu
spike/*.exe
spike/units/


# Test builds sent to the radio-bench testers -- packaged by FullBuild.ps1 and
# handed out per rig, not release history. The release itself is a tag.
tr4w/build/release/*.zip
tr4w/build/release/README_*.txt
