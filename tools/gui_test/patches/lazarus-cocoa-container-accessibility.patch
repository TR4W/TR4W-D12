 { TCocoaCustomControl }
 
+function TCocoaCustomControl.accessibilityChildren: NSArray;
+var
+   ChildViews: NSArray;
+   VisibleChildren: NSMutableArray;
+   Child: NSView;
+   I: NSInteger;
+begin
+   // NSControl does not enumerate child views by default. LCL uses this
+   // class as a container. Preserve native hidden-view filtering.
+   ChildViews := subviews;
+   VisibleChildren := NSMutableArray.arrayWithCapacity(ChildViews.count);
+   for I := 0 to NSInteger(ChildViews.count) - 1 do
+      begin
+      Child := NSView(ChildViews.objectAtIndex(I));
+      if not Child.isHiddenOrHasHiddenAncestor then
+         begin
+         VisibleChildren.addObject(Child);
+         end;
+      end;
+   Result := NSAccessibilityUnignoredChildren(VisibleChildren);
+end;
