#!/bin/sh
#
# Strip the Claude-Session trailer before it reaches a commit.
#
# TR4W/TR4W-D12 IS A PUBLIC REPOSITORY. A "Claude-Session: https://claude.ai/..."
# trailer is a link to a private transcript, and it does not belong in a public
# commit message.
#
# THIS HOOK IS OPTIONAL. THE RULE IN CLAUDE.md IS THE CONTROL.
#
# Correcting an earlier claim in this file: it was NOT that a rule existed and
# failed. CLAUDE.md said nothing about the trailer until 2026-08-29 -- zero
# mentions -- so twelve commits carried one simply because nothing had ever
# asked them not to. The one-line rule is the fix; this is a net under it.
#
# It matters that this is opt-in: `core.hooksPath` is per-clone local config and
# does not travel with the repository, so a clone without it has an inert hook
# file and no protection. Do not treat its presence as enforcement.
#
# It strips rather than rejecting. A rejection is something to work around at
# 3am; a strip just makes the commit correct. It prints what it removed so the
# change is never silent.
#
# For context on why this matters: on 2026-08-19 someone ran `git filter-branch`
# over `fpc` to strip 714 of these trailers and force-pushed the result. Every
# other clone had to be rebuilt by hand -- 200+ conflicts on the next pull,
# because rewriting also dropped the SSH signatures and so changed every SHA.
# That is the cost of removing one after the fact.
#
# THE STANDING RULE THIS PROTECTS: the fix for a trailer that slipped through is
# to stop emitting it, NEVER to rewrite published history. See CLAUDE.md,
# "MANDATORY: Never force-push `fpc`".
#
# Install (once per clone):
#     git -C /c/tr4w-d12 config core.hooksPath .githooks

set -e

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

if grep -q '^Claude-Session:' "$MSG_FILE" 2>/dev/null; then
   COUNT=$(grep -c '^Claude-Session:' "$MSG_FILE")
   grep -v '^Claude-Session:' "$MSG_FILE" > "$MSG_FILE.stripped"
   mv "$MSG_FILE.stripped" "$MSG_FILE"
   echo "commit-msg: removed $COUNT Claude-Session trailer(s) -- this repo is public." >&2
fi

exit 0
