      "lazarus_diff": "diff --git a/lcl/interfaces/cocoa/cocoacustomcontrol.pas b/lcl/interfaces/cocoa/cocoacustomcontrol.pas\nindex 5d00ca54..fb0fa201 100644\n--- a/lcl/interfaces/cocoa/cocoacustomcontrol.pas\n+++ b/lcl/interfaces/cocoa/cocoacustomcontrol.pas\n@@ -24,6 +24,7 @@ type\n   public\n     callback: ICommonCallback;\n     auxMouseByParent: Boolean;\n+   function accessibilityChildren: NSArray; override;\n     procedure dealloc; override;\n     function acceptsFirstResponder: LCLObjCBoolean; override;\n     procedure drawRect(dirtyRect: NSRect); override;\n@@ -91,6 +92,28 @@ implementation\n \n { TCocoaCustomControl }\n \n+function TCocoaCustomControl.accessibilityChildren: NSArray;\n+var\n+   ChildViews: NSArray;\n+   VisibleChildren: NSMutableArray;\n+   Child: NSView;\n+   I: NSInteger;\n+begin\n+   // NSControl does not enumerate child views by default. LCL uses this\n+   // class as a container. Preserve native hidden-view filtering.\n+   ChildViews := subviews;\n+   VisibleChildren := NSMutableArray.arrayWithCapacity(ChildViews.count);\n+   for I := 0 to NSInteger(ChildViews.count) - 1 do\n+      begin\n+      Child := NSView(ChildViews.objectAtIndex(I));\n+      if not Child.isHiddenOrHasHiddenAncestor then\n+         begin\n+         VisibleChildren.addObject(Child);\n+         end;\n+      end;\n+   Result := NSAccessibilityUnignoredChildren(VisibleChildren);\n+end;\n+\n procedure TCocoaCustomControl.setStringValue(avalue: NSString);\n begin\n   if Assigned(fstr) then fstr.release;\n",
