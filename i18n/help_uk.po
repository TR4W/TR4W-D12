msgctxt "TC_HELP_DVK_LOCALIZED_MESSAGES_ENABLE"
msgid "TO BE COMPLETED"
msgstr ""

#. Config command: EXCHANGE WINDOW S&P BACKGROUND   (default: Green)
#, fuzzy
msgctxt "TC_HELP_EXCHANGE_WINDOW_S_P_BACKGROUND"
msgid "The background color of the Exchange window when in S&P mode."
msgstr "Фоновий колір вікна Exchange при режимі S&P."

#. Config command: HAMLIB ASYNC ONLY   (default: FALSE)
#, fuzzy
msgctxt "TC_HELP_HAMLIB_ASYNC_ONLY"
msgid "This is a debugging option for investigating HamLib issues."
