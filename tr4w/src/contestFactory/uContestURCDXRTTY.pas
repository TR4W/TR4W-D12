(* THE URC DX RTTY CONTEST -- added 2026-10-22 (open question Q138).

  THE SOURCE. The sponsor's rules as NY4I saved them,
  docs/ContestRules/URC/rules.md (the URC DX RTTY Contest page on UA9QCQ's
  log robot; organiser https://unicomradio.com), and the URC DX Territories
  List, docs/ContestRules/URC/territories.md. Nothing here comes from D7,
  which never had this contest.

  A NEW CONTEST, SO IT REGISTERS BY ITS ID (Q108 S3/S4): it has no
  ContestType member, no legacy number, no VC.pas entry. Its id
  'URC-DX-RTTY' is STORED DATA from today (every log's contest row) and is
  never given to another contest. The multi-op network refuses it and its
  UDP <contestnr> is derived from the id -- both the registry's, nothing
  here.

  THE CONTEST, rule by rule, and where each lives:
    * schedule -- the 1st Friday of October, 00:00-23:59 UTC. TR4W has no
      schedule seam; stated here only.
    * mode -- RTTY only: RunsInMode (Digital), and DescribeSession starts
      the session in Digital.
    * bands -- 160, 80, 40, 20, 15 and 10 m, no WARC: UsesBand. A QSO on
      any other band is logged, scores 0 and earns no multiplier (ScoreQSO,
      SetMultFlags, the dupe sheet).
    * exchange -- RST + the 3-letter territory code of the URC list, looked
      up in urc.dom (generated by tools/urc/make_urc_dom.py): the contest's
      format is the engine's RST-and-domestic-QTH parser, so a code the list
      does not hold is refused as an improper domestic QTH. A maritime
      mobile station sends MMS wherever it is: MMS is NOT in urc.dom (it is
      no multiplier), and ParseReceivedExchange reads it itself.
    * what I send -- RST + MY STATE, which holds MY territory code (the
      sent-state column every RST-and-state contest uses).
    * points -- CalculateQSOPoints: maritime mobile 3; the same territory
      (the received code is MY code) 1; else by continent and band, from
      CTY.DAT's continent of the two stations, as every DX contest here.
    * multipliers -- each territory once per band: the domestic multiplier
      (UsesDomesticFile, cfMultByBand). MMS is never one (CountsAsMultiplier
      says so even if MMS were ever added to the file). No DX, zone or
      prefix multiplier.
    * score -- the QSO points times the sum of the territory multipliers:
      the base's CombineWithMultipliers, which is exactly that.
    * dupes -- once per band (cfQSOByBand); RTTY only, so not by mode.
    * logs -- Cabrillo, CONTEST: URCDX (the rules' header examples), sent
      through the sponsor's web form within 5 days: no submission e-mail.
      oleg@ua9qcq.com is only for an unanswered upload, so it is not one.

  THE MULTIPLIER IS THE CODE ITSELF. urc.dom maps each code to itself
  (CLB = CLB, ^name), so the multiplier is the 3-letter code and never a
  territory name cut to the table's key width.

  NO ADIF CONTEST_ID EXISTS for it (ADIF 3.1.6's Contest_ID enumeration has
  no URC entry, checked 2026-10-22), so export writes the contest's own id,
  as a by-id contest does, and import matches it. *)
unit uContestURCDXRTTY;

{$I tr4w.inc}

interface

uses
   VC, uContestBase;

const
   (* ITS ID -- stored data; see the header. *)
   URC_DX_RTTY_CONTEST_ID = 'URC-DX-RTTY';
   (* What a maritime mobile station sends, wherever it is. *)
   URC_MARITIME_MOBILE_CODE = 'MMS';

type
   TContestURCDXRTTY = class(TContestBase)
   protected
      function GetDisplayName: string; override;
      function GetCabrilloName: string; override;
      function GetADIFContestId: string; override;
      function GetWA7BNMId: integer; override;
      function GetQRZRUId: integer; override;
      function GetSubmissionEmail: string; override;
      function GetDomesticFileName: string; override;
      function GetFriendlyName: string; override;
      function GetInitialExchangeKind: InitialExchangeType; override;
      function GetExchangeKind: ExchangeType; override;
      function GetReceivedExchangeFields: ExchangeInformationRecord; override;
      function ParseReceivedExchangeFormat(const aText: string;
                                           aParsers: TExchangeParsers;
                                           var aExch: ContestExchange): boolean; override;
      procedure WriteDefaultExchangeMessages(aMessages: TExchangeMessageWriters); override;
      function GetADIFSentExchange(const aMy: TMyStationExchange;
                                   const aQso: ContestExchange): string; override;
      function GetCabrilloSentExchange(const aMy: TMyStationExchange;
                                       const aQso: ContestExchange;
                                       const aCtx: TCabrilloQSOContext): string; override;
      function GetCabrilloReceivedExchange(const aMy: TMyStationExchange;
                                           const aQso: ContestExchange;
                                           const aCtx: TCabrilloQSOContext): string; override;

      (* Its yes/no facts -- see TContestBase.GetFlags. *)
      function GetFlags: TContestFlags; override;
      function GetIsUSQSOParty: boolean; override;
      (* THE CONTEST'S OWN RULE -- see the header. Protected, as on
         TContestBase: ScoreQSO is the one public scoring entry. *)
      procedure CalculateQSOPoints(var aQso: ContestExchange); override;
   public
      (* THE CODE A QSO RECEIVED -- the QTH as received, upper case: the
         code, or MMS. urc.dom maps every code to itself, so this is also
         the multiplier. Public for the tests; nothing else needs it. *)
      class function ReceivedTerritoryCode(const aQso: ContestExchange): string;
      (* IS THIS TYPED EXCHANGE A MARITIME MOBILE'S? -- an optional RST,
         then MMS, and nothing else. *)
      class function TypedExchangeIsMaritimeMobile(const aText: string): boolean;
   public
      (* THE BANDS AND THE MODE -- see the header and TContestBase.UsesBand,
         RunsInMode. *)
      function UsesBand(aBand: BandType): boolean; override;
      function RunsInMode(aMode: ModeType): boolean; override;
      (* MMS IS NO MULTIPLIER -- see TContestBase.CountsAsMultiplier. *)
      function CountsAsMultiplier(const aQso: ContestExchange;
                                  aKind: RemainingMultiplierType): boolean; override;
      (* MMS IS READ HERE; every code goes to the contest's format. *)
      function ParseReceivedExchange(const aText: string;
                                     const aSession: TReceivedExchangeSession;
                                     var aExch: ContestExchange;
                                     out aErrorMessage: string): boolean; override;
   public
      (* SET-UP -- see TContestBase.DescribeSession. *)
      procedure DescribeSession(const aStation: TStationContext;
                                aSession: TSessionDefaults); override;
      (* THE NEW CONTEST DIALOG'S PROMPTS -- MY STATE is my territory code. *)
      procedure DescribeNewContestPrompts(aPrompts: TNewContestPrompts); override;
   public
      (* THE MULTIPLIERS -- the territory, a domestic multiplier looked up in
         urc.dom; no DX, zone or prefix multiplier. *)
      function UsesDomesticFile: boolean; override;
      function HasDXMultiplier: boolean; override;
      function HasZoneMultiplier: boolean; override;
      function HasPrefixMultiplier: boolean; override;
      (* THE EXCHANGE CARRIES A DOMESTIC QTH -- the territory code; the
         readiness check then asks for MY STATE. *)
      function ExchangeCarriesDomesticQTH: boolean; override;
   end;

implementation

uses
   SysUtils,
   uExchangeFields,
   uCabrilloExchange,
   uADIFExchange,
   uContestRegistry;

(* THE POINTS -- the rules' "Points for QSO", in their order of precedence:
   a maritime mobile station 3 on any band; the same territory 1 on any band;
   the same continent but another territory 2 on 40/20/15 m, 3 on 10 and
   80 m, 5 on 160 m; another continent 4 on 40/20/15 m, 5 on 10 m, 6 on 80 m,
   10 on 160 m.

   THE SAME TERRITORY IS THE CODE, not the country: the received code is MY
   code (MY STATE). With no code of my own stated, no QSO is "the same
   territory", and it scores by continent.

   A CODE THE LIST DOES NOT HOLD (an imported record -- a typed one is
   refused) scores by continent like any other, and earns no multiplier
   because urc.dom does not know it. The rules say nothing of it; the
   sponsor's checker removes such a QSO.

   THE BAND IS ALWAYS ONE OF THE SIX: ScoreQSO never asks about another
   (UsesBand), so the `else` arms are unreachable and score 0. *)
procedure TContestURCDXRTTY.CalculateQSOPoints(var aQso: ContestExchange);
var
   code: string;
   myCode: string;
begin
   code := ReceivedTerritoryCode(aQso);
   myCode := UpperCase(Trim(Station.MyState));

   if code = URC_MARITIME_MOBILE_CODE then
      begin
      aQso.QSOPoints := 3;
      Exit;
      end;

   if (myCode <> '') and (code = myCode) then
      begin
      aQso.QSOPoints := 1;
      Exit;
      end;

   if aQso.QTH.Continent = Station.MyContinent then
      begin
      case aQso.Band of
         Band160:
            begin
            aQso.QSOPoints := 5;
            end;
         Band80, Band10:
            begin
            aQso.QSOPoints := 3;
            end;
         Band40, Band20, Band15:
            begin
            aQso.QSOPoints := 2;
            end;
         else
            begin
            aQso.QSOPoints := 0;
            end;
      end;
      end
   else
      begin
      case aQso.Band of
         Band160:
            begin
            aQso.QSOPoints := 10;
            end;
         Band80:
            begin
            aQso.QSOPoints := 6;
            end;
         Band10:
            begin
            aQso.QSOPoints := 5;
            end;
         Band40, Band20, Band15:
            begin
            aQso.QSOPoints := 4;
            end;
         else
            begin
            aQso.QSOPoints := 0;
            end;
      end;
      end;
end;

class function TContestURCDXRTTY.ReceivedTerritoryCode(const aQso: ContestExchange): string;
begin
   Result := UpperCase(Trim(string(aQso.QTHString)));
end;

(* AN OPTIONAL RST, THEN MMS, AND NOTHING ELSE -- '599 MMS' or 'MMS'. A word
   beside MMS that is not a report ('MMS CLB') is not a maritime mobile's
   exchange, and goes to the contest's format, which refuses MMS. *)
class function TContestURCDXRTTY.TypedExchangeIsMaritimeMobile(const aText: string): boolean;
var
   typed: string;
   words: array of string;
   current: string;
   i: integer;
begin
   Result := False;

   (* The words, split at blanks. *)
   typed := UpperCase(aText) + ' ';
   SetLength(words, 0);
   current := '';
   for i := 1 to Length(typed) do
      begin
      if typed[i] = ' ' then
         begin
         if current <> '' then
            begin
            SetLength(words, Length(words) + 1);
            words[High(words)] := current;
            current := '';
            end;
         end
      else
         begin
         current := current + typed[i];
         end;
      end;

   if (Length(words) < 1) or (Length(words) > 2) then
      begin
      Exit;
      end;

   if words[High(words)] <> URC_MARITIME_MOBILE_CODE then
      begin
      Exit;
      end;

   (* A word before MMS must be the report: digits only. *)
   if Length(words) = 2 then
      begin
      for i := 1 to Length(words[0]) do
         begin
         if (words[0][i] < '0') or (words[0][i] > '9') then
            begin
            Exit;
            end;
         end;
      end;

   Result := True;
end;

(* MMS IS READ HERE: the engine's RST-and-QTH parser takes the report and the
   word as they are, and the QTH is MMS. Every other exchange is the
   contest's format (inherited), which looks the code up in urc.dom. *)
function TContestURCDXRTTY.ParseReceivedExchange(const aText: string;
                                                 const aSession: TReceivedExchangeSession;
                                                 var aExch: ContestExchange;
                                                 out aErrorMessage: string): boolean;
begin
   if TypedExchangeIsMaritimeMobile(aText) then
      begin
      aErrorMessage := '';
      Result := aSession.Parsers.ParseRSTQTH(aText, aExch);
      if Result then
         begin
         aExch.QTHString := URC_MARITIME_MOBILE_CODE;
         end;
      Exit;
      end;

   Result := inherited ParseReceivedExchange(aText, aSession, aExch, aErrorMessage);
end;

function TContestURCDXRTTY.CountsAsMultiplier(const aQso: ContestExchange;
                                              aKind: RemainingMultiplierType): boolean;
begin
   Result := not ((aKind = rmDomestic) and
                  (ReceivedTerritoryCode(aQso) = URC_MARITIME_MOBILE_CODE));
end;

function TContestURCDXRTTY.UsesBand(aBand: BandType): boolean;
begin
   Result := aBand in [Band160, Band80, Band40, Band20, Band15, Band10];
end;

function TContestURCDXRTTY.RunsInMode(aMode: ModeType): boolean;
begin
   Result := aMode = Digital;
end;

function TContestURCDXRTTY.GetDisplayName: string;
begin
   Result := 'URC DX RTTY Contest';
end;

function TContestURCDXRTTY.GetCabrilloName: string;
begin
   (* The rules' header examples: CONTEST: URCDX. *)
   Result := 'URCDX';
end;

function TContestURCDXRTTY.GetADIFContestId: string;
begin
   (* ADIF has no id for it -- see the header. *)
   Result := URC_DX_RTTY_CONTEST_ID;
end;

function TContestURCDXRTTY.GetWA7BNMId: integer;
begin
   (* Not looked up: no WA7BNM reference was available on 2026-10-22. *)
   Result := 0;
end;

function TContestURCDXRTTY.GetQRZRUId: integer;
begin
   Result := 0;
end;

function TContestURCDXRTTY.GetSubmissionEmail: string;
begin
   (* Logs go through the sponsor's web form -- see the header. *)
   Result := '';
end;

function TContestURCDXRTTY.GetDomesticFileName: string;
begin
   Result := 'urc';
end;

function TContestURCDXRTTY.GetFriendlyName: string;
begin
   Result := 'URC DX RTTY Contest';
end;

function TContestURCDXRTTY.GetInitialExchangeKind: InitialExchangeType;
begin
   Result := NoInitialExchange;
end;

function TContestURCDXRTTY.GetExchangeKind: ExchangeType;
begin
   Result := RSTDomesticQTHExchange;
end;

function TContestURCDXRTTY.GetReceivedExchangeFields: ExchangeInformationRecord;
begin
   Result := ExchangeFieldsRSTQTH;
end;

function TContestURCDXRTTY.ParseReceivedExchangeFormat(const aText: string;
                                                       aParsers: TExchangeParsers;
                                                       var aExch: ContestExchange): boolean;
begin
   Result := aParsers.ParseRSTDomesticQTH(aText, aExch);
end;

(* RST AND MY STATE -- my territory code. The writer falls back to a serial
   when no state is stated; the readiness check asks for MY STATE first
   (ExchangeCarriesDomesticQTH). *)
procedure TContestURCDXRTTY.WriteDefaultExchangeMessages(aMessages: TExchangeMessageWriters);
begin
   aMessages.WriteRSTStateOrQSONumber;
end;

function TContestURCDXRTTY.GetADIFSentExchange(const aMy: TMyStationExchange;
                                               const aQso: ContestExchange): string;
begin
   Result := ADIFSentRSTState(aMy, aQso);
end;

function TContestURCDXRTTY.GetCabrilloSentExchange(const aMy: TMyStationExchange;
                                                   const aQso: ContestExchange;
                                                   const aCtx: TCabrilloQSOContext): string;
begin
   Result := CabrilloSentRSTState(aMy, aQso, aCtx);
end;

(* THE RECEIVED CODE AS RECEIVED, not the exporter's his-QTH: for a
   domestic-multiplier contest that is the record's DomesticQTH, which a
   maritime mobile's MMS never has (it is not in urc.dom), so the column
   would be blank. Only the input differs, so the shared layout prints it. *)
function TContestURCDXRTTY.GetCabrilloReceivedExchange(const aMy: TMyStationExchange;
                                                       const aQso: ContestExchange;
                                                       const aCtx: TCabrilloQSOContext): string;
var
   ctx: TCabrilloQSOContext;
begin
   ctx := aCtx;
   ctx.HisQTH := ReceivedTerritoryCode(aQso);
   Result := CabrilloReceivedRSTQTH(aMy, aQso, ctx);
end;

function TContestURCDXRTTY.GetFlags: TContestFlags;
begin
   (* QSOs and multipliers once per band; RTTY only, so not by mode. *)
   Result := [cfQSOByBand, cfMultByBand];
end;

function TContestURCDXRTTY.GetIsUSQSOParty: boolean;
begin
   Result := False;
end;

procedure TContestURCDXRTTY.DescribeSession(const aStation: TStationContext;
                                            aSession: TSessionDefaults);
begin
   aSession.Mode := Digital;
end;

procedure TContestURCDXRTTY.DescribeNewContestPrompts(aPrompts: TNewContestPrompts);
begin
   inherited DescribeNewContestPrompts(aPrompts);
   aPrompts.AskField(ncfMyState);
end;

function TContestURCDXRTTY.UsesDomesticFile: boolean;
begin
   Result := True;
end;

function TContestURCDXRTTY.HasDXMultiplier: boolean;
begin
   Result := False;
end;

function TContestURCDXRTTY.HasZoneMultiplier: boolean;
begin
   Result := False;
end;

function TContestURCDXRTTY.HasPrefixMultiplier: boolean;
begin
   Result := False;
end;

function TContestURCDXRTTY.ExchangeCarriesDomesticQTH: boolean;
begin
   Result := True;
end;

initialization
   RegisterContestById(URC_DX_RTTY_CONTEST_ID, TContestURCDXRTTY);

end.
