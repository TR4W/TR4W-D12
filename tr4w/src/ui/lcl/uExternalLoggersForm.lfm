object ExternalLoggersForm: TExternalLoggersForm
  Left = 200
  Top = 150
  Width = 710
  Height = 600
  Caption = 'External logger'
  Position = poScreenCenter
  BorderStyle = bsDialog
  ClientWidth = 710
  ClientHeight = 600
  object lblName: TLabel
    Left = 16
    Top = 24
    Width = 190
    Height = 24
    Caption = 'Name'
  end
  object edtName: TEdit
    Left = 216
    Top = 20
    Width = 470
    Height = 28
    TabOrder = 0
  end
  object lblProvider: TLabel
    Left = 16
    Top = 66
    Width = 190
    Height = 24
    Caption = 'Provider'
  end
  object cbProvider: TComboBox
    Left = 216
    Top = 62
    Width = 470
    Height = 28
    TabOrder = 1
    Style = csDropDownList
    OnChange = ProviderChanged
  end
  object lblAddress: TLabel
    Left = 16
    Top = 108
    Width = 190
    Height = 24
    Caption = 'Host / IP address'
  end
  object edtAddress: TEdit
    Left = 216
    Top = 104
    Width = 470
    Height = 28
    TabOrder = 2
  end
  object lblPort: TLabel
    Left = 16
    Top = 150
    Width = 190
    Height = 24
    Caption = 'Port'
  end
  object edtPort: TEdit
    Left = 216
    Top = 146
    Width = 470
    Height = 28
    TabOrder = 3
  end
  object lblURL: TLabel
    Left = 16
    Top = 192
    Width = 190
    Height = 24
    Caption = 'Instance URL'
  end
  object edtURL: TEdit
    Left = 216
    Top = 188
    Width = 470
    Height = 28
    TabOrder = 4
  end
  object lblAccount: TLabel
    Left = 16
    Top = 234
    Width = 190
    Height = 24
    Caption = 'Email / account ID'
  end
  object edtAccount: TEdit
    Left = 216
    Top = 230
    Width = 470
    Height = 28
    TabOrder = 5
  end
  object lblLogbook: TLabel
    Left = 16
    Top = 276
    Width = 190
    Height = 24
    Caption = 'Callsign / logbook ID'
  end
  object edtLogbook: TEdit
    Left = 216
    Top = 272
    Width = 470
    Height = 28
    TabOrder = 6
  end
  object lblApiKey: TLabel
    Left = 16
    Top = 318
    Width = 190
    Height = 24
