  ClientHeight = 650
  object lblOrder: TLabel
    Left = 16
    Top = 12
    Width = 260
    Height = 36
    Caption = 'Active loggers (*) send in the listed order.'
    WordWrap = True
  end
  object lstLoggers: TListBox
    Left = 16
    Top = 54
    Width = 260
    Height = 378
    TabOrder = 0
    OnClick = SelectLogger
  end
  object lblName: TLabel
    Left = 300
    Top = 24
    Width = 190
    Height = 24
    Caption = 'Name'
  end
  object edtName: TEdit
    Left = 500
    Top = 20
    Width = 330
    Height = 28
    TabOrder = 5
  end
  object lblProvider: TLabel
    Left = 300
    Top = 66
    Width = 190
    Height = 24
    Caption = 'Provider'
  end
  object cbProvider: TComboBox
    Left = 500
    Top = 62
    Width = 330
    Height = 28
    TabOrder = 6
