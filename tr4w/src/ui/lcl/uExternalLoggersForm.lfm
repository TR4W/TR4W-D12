    Left = 500
    Top = 146
    Width = 330
    Height = 28
    TabOrder = 8
  end
  object lblURL: TLabel
    Left = 300
    Top = 192
    Width = 190
    Height = 24
    Caption = 'Instance URL'
  end
  object edtURL: TEdit
    Left = 500
    Top = 188
    Width = 330
    Height = 28
    TabOrder = 9
  end
  object lblAccount: TLabel
    Left = 300
    Top = 234
    Width = 190
    Height = 24
    Caption = 'Email / account ID'
  end
  object edtAccount: TEdit
    Left = 500
    Top = 230
    Width = 330
    Height = 28
    TabOrder = 10
  end
  object lblLogbook: TLabel
    Left = 300
    Top = 276
    Width = 190
    Height = 24
    Caption = 'Callsign / logbook ID'
  end
  object edtLogbook: TEdit
    Left = 500
    Top = 272
    Width = 330
    Height = 28
    TabOrder = 11
