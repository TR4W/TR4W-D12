  end
  object lblPassword: TLabel
    Left = 16
    Top = 360
    Width = 190
    Height = 24
    Caption = 'Application password'
  end
  object edtPassword: TEdit
    Left = 216
    Top = 356
    Width = 470
    Height = 28
    TabOrder = 8
    PasswordChar = '*'
  end
  object chkActive: TCheckBox
    Left = 16
    Top = 405
    Width = 300
    Height = 28
