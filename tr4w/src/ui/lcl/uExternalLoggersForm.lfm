  end
  object lblPassword: TLabel
    Left = 300
    Top = 360
    Width = 190
    Height = 24
    Caption = 'Application password'
  end
  object edtPassword: TEdit
    Left = 500
    Top = 356
    Width = 330
    Height = 28
    TabOrder = 13
    PasswordChar = '*'
  end
  object chkActive: TCheckBox
    Left = 300
    Top = 405
    Width = 300
    Height = 28
    AutoSize = True
    Caption = 'Active (send newly logged QSOs)'
    TabOrder = 14
  end
  object btnAdd: TButton
    Left = 16
    Top = 444
    Width = 110
    Height = 32
