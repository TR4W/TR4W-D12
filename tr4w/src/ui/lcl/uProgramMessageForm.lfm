object frmProgramMessage: TfrmProgramMessage
  Left = 0
  Height = 116
  Top = 0
  Width = 410
  BorderIcons = [biSystemMenu]
  BorderStyle = bsDialog
  Caption = 'Memory program function'
  ClientHeight = 116
  ClientWidth = 410
  KeyPreview = True
  Position = poMainFormCenter
  OnClose = HandleClose
  OnKeyDown = HandleKeyDown
  OnShow = HandleShow
  object btnCQ: TButton
    Left = 30
    Height = 26
    Top = 20
    Width = 350
    AutoSize = False
    Caption = 'Press &C to program a CQ function key.'
    OnClick = btnCQClick
    TabOrder = 0
  end
  object btnExchange: TButton
    Left = 30
    Height = 26
    Top = 50
    Width = 350
    AutoSize = False
    Caption = 'Press &E to program an exchange/search and pounce function key.'
    OnClick = btnExchangeClick
    TabOrder = 1
  end
  object btnOther: TButton
    Left = 30
    Height = 26
    Top = 80
    Width = 350
    AutoSize = False
    Caption = 'Press &O to program the other non function key messages.'
    OnClick = btnOtherClick
    TabOrder = 2
  end
end
