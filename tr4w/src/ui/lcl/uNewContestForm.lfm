  ClientWidth = 740
  Constraints.MinHeight = 460
  Constraints.MinWidth = 680
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  OnCreate = HandleCreate
  OnShow = HandleShow
  object gbExisting: TGroupBox
    Left = 8
    Height = 468
    Top = 8
    Width = 300
