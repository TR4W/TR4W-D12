  ClientWidth = 620
  Constraints.MinHeight = 490
  Constraints.MinWidth = 620
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  OnCreate = HandleCreate
  OnShow = HandleShow
  object lblFiles: TLabel
    Left = 8
    Height = 18
    Top = 8
    Width = 252
