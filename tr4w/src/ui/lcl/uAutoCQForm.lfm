object frmAutoCQ: TfrmAutoCQ
  Left = 0
  Height = 140
  Top = 0
  Width = 330
  BorderIcons = [biSystemMenu]
  BorderStyle = bsDialog
  Caption = 'Auto-CQ'
  ClientHeight = 140
  ClientWidth = 330
  Position = poMainFormCenter
  LCLVersion = '4.8.0.0'
  OnClose = HandleClose
  OnShow = HandleShow
  object lblMemoryKey: TLabel
    Left = 10
    Height = 32
    Top = 10
    Width = 215
    AutoSize = False
    Caption = 'Press the memory key you want to repeat:'
    ParentColor = False
    WordWrap = True
  end
  object edtHotKey: TEdit
    Left = 235
    Height = 23
    Top = 10
    Width = 85
    Alignment = taCenter
    AutoSize = False
    ReadOnly = True
    TabOrder = 0
    OnKeyDown = edtHotKeyKeyDown
  end
  object lblDelay: TLabel
    Left = 10
    Height = 32
    Top = 52
    Width = 215
    AutoSize = False
    Caption = 'Number of milliseconds of listening time:'
    ParentColor = False
    WordWrap = True
  end
  object spnDelay: TSpinEdit
    Left = 235
    Height = 23
    Top = 52
    Width = 85
    AutoSize = False
    Increment = 250
    MaxValue = 10000
    MinValue = 500
    TabOrder = 1
    Value = 500
  end
  object btnOK: TButton
    Left = 80
    Height = 25
    Top = 100
    Width = 80
    Caption = 'OK'
    Default = True
    TabOrder = 2
    OnClick = btnOKClick
  end
  object btnCancel: TButton
    Left = 170
    Height = 25
    Top = 100
    Width = 80
    Cancel = True
    Caption = 'Cancel'
    TabOrder = 3
    OnClick = btnCancelClick
  end
end
