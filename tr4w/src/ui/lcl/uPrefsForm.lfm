        Caption = 
          'PstRotator is reached over UDP and has no serial port; the other' +
          's use one.  A blank baud rate lets each type use what it expects' +
          ' - the DCU-1 wants 4800 where the rest want 9600.'
        ParentFont = False
        Font.Color = clGrayText
      end
