<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <assemblyIdentity
        type="win32"
        name="TR4W"
        version="1.2.3.4"
        processorArchitecture="*"
    />
    <!-- processorArchitecture IS "*", NOT "x86", AND THAT IS LOAD-BEARING.

         A side-by-side dependency is resolved by ARCHITECTURE. An x86
         Common-Controls assembly cannot be satisfied inside an x64 process, so
         a manifest saying "x86" makes a 64-bit build fail with

             The application was unable to start correctly (0xc000007b).

         that is STATUS_INVALID_IMAGE_FORMAT, raised by the LOADER before a
         line of code runs. It looks exactly like a 32/64-bit DLL mix-up and it is not:
         measured 2026-09-14, the x64 binary had seven correct x86_64 DLLs
         beside it and stopped with comctl32.dll as the next module it had not
         yet loaded.

         "*" means "whatever this process is", so ONE manifest serves both
         builds. Do not put a bitness back in.

         The neighbouring warning still applies: no double hyphen inside an XML
         comment. -->
    <description>TR4W Contest Logger</description>
    <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
        <application>
            <!-- Windows 10 and Windows 11 -->
            <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
            <!-- Windows 8.1 -->
            <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
            <!-- Windows 8 -->
            <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
            <!-- Windows 7 -->
            <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
            <!-- Windows Vista -->
            <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/> 
        </application>
    </compatibility>
    <!-- VISUAL STYLES. Without this dependency Windows renders every stock
         control (buttons, edits, combo boxes, list boxes, the tree view) in the
         CLASSIC unthemed style, which is Windows 2000 chrome on a Windows 11
         desktop. It is not an LCL limitation and it costs no code; the manifest
         simply never asked for it. Verified absent from the shipped 5.0.0 exe
         before this was added.

         NOTE: no double hyphen may appear inside an XML comment. One here made
         the whole manifest malformed, and Windows answered with "the side-by-side
         configuration is incorrect" and refused to start the program at all. -->
    <dependency>
        <dependentAssembly>
            <assemblyIdentity
                type="win32"
                name="Microsoft.Windows.Common-Controls"
                version="6.0.0.0"
                processorArchitecture="*"
                publicKeyToken="6595b64144ccf1df"
                language="*"
            />
        </dependentAssembly>
    </dependency>

    <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
        <security>
            <requestedPrivileges>
                <!--
                  UAC settings:
                  - app should run at same integrity level as calling process
                  - app does not need to manipulate windows belonging to
                    higher-integrity-level processes
                  -->
                <requestedExecutionLevel
                    level="asInvoker"
                    uiAccess="false"
                />   
            </requestedPrivileges>
        </security>
    </trustInfo>
</assembly>