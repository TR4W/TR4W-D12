In = IN,^Indiana
Ks = KA, KS,^Kansas
Ky = KE, KY,^Kentucky
La = L,LA,^Louisiana
Ma = MA,^Massachusetts
Md = MD, MARY,^Maryland
Me = ME,^Maine
Mi = MI,^Michigan
Mn = MN, MIN,^Minnesota
Mo = MO, MISSO,^Missouri
Ms = MS, MIS,^Mississippi
Mt = MT, ^Montana
Nd = ND,^North Dakota
Ne = NE,^Nebraska
Nh = NH,^New Hampshire
Nj = NJ,^New Jersey
Nm = NM,^New Mexico
Nv = NV, NEV,^Nevada
Ny = NY,^New York
Oh = OH,^Ohio
Ok = OK,^Oklahoma
Or = OR,^Oregon
Pa = PA,^Pennsylvania
Ri = RI,^Rhode Island
