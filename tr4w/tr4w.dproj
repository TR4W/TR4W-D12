<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{83EAA32B-D268-4CCB-9215-B1DA33F7E195}</ProjectGuid>
        <MainSource>tr4w.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <ProjectName Condition="'$(ProjectName)'==''">tr4w</ProjectName>
        <TargetedPlatforms>135169</TargetedPlatforms>
        <AppType>Console</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>20.1</ProjectVersion>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
        <!-- Pre-build gate: radio-registry collisions are a STATIC property of the
             source and are invisible both at compile time and at run time (see
             build\Lint-RadioRegistry.ps1).  A non-zero exit fails the build. -->
        <!-- $(MSBuildProjectDirectory), not $(PROJECTDIR): the latter is an IDE-only
             macro and expands to empty under msbuild, which broke the command. -->
        <PreBuildEvent><![CDATA[powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\build\Lint-RadioRegistry.ps1" -SourceDir "$(MSBuildProjectDirectory)\src"
powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\build\Lint-PollRadioState.ps1" -SourceDir "$(MSBuildProjectDirectory)\src"
powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\build\Lint-PCharAnsi.ps1" -SourceDir "$(MSBuildProjectDirectory)\src"
powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\build\Lint-LineEndings.ps1" -SourceDir "$(MSBuildProjectDirectory)"
powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\build\Lint-FormTags.ps1" -SourceDir "$(MSBuildProjectDirectory)\src"
powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\build\Lint-FormFields.ps1" -SourceDir "$(MSBuildProjectDirectory)\src"
powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\build\Lint-FormOverlap.ps1" -SourceDir "$(MSBuildProjectDirectory)\src"
powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\build\Lint-ConfigOwnership.ps1" -SourceDir "$(MSBuildProjectDirectory)\src"]]></PreBuildEvent>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='OSX64' and '$(Cfg_2)'=='true') or '$(Cfg_2_OSX64)'!=''">
        <Cfg_2_OSX64>true</Cfg_2_OSX64>
        <CfgParent>Cfg_2</CfgParent>
        <Cfg_2>true</Cfg_2>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='OSXARM64' and '$(Cfg_2)'=='true') or '$(Cfg_2_OSXARM64)'!=''">
        <Cfg_2_OSXARM64>true</Cfg_2_OSXARM64>
        <CfgParent>Cfg_2</CfgParent>
        <Cfg_2>true</Cfg_2>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Cfg_2)'=='true') or '$(Cfg_2_Win32)'!=''">
        <Cfg_2_Win32>true</Cfg_2_Win32>
        <CfgParent>Cfg_2</CfgParent>
        <Cfg_2>true</Cfg_2>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>true</DCC_N>
        <DCC_S>false</DCC_S>
        <!-- Pin the binary record/enum layout that the .dat log format and the
             network wire protocol depend on. The legacy D7 tr4w.cfg carried these
             as -$A8 (record field alignment = 8) and -$Z1 (minimum enum size = 1);
             tr4w.cfg has been removed, so set them explicitly here rather than rely
             on compiler defaults (which a future toolchain/IDE re-save could change
             out from under the wire format). Verified byte-compatible with the D7
             refs by the golden-master corpus. -->
        <DCC_Alignment>8</DCC_Alignment>
        <DCC_MinimumEnumSize>1</DCC_MinimumEnumSize>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <DCC_AssertionsAtRuntime>false</DCC_AssertionsAtRuntime>
        <DCC_DebugInformation>1</DCC_DebugInformation>
        <DCC_Hints>false</DCC_Hints>
        <DCC_Warnings>false</DCC_Warnings>
        <DCC_ExeOutput>target</DCC_ExeOutput>
        <DCC_UnitSearchPath>src;src\ui\fmx;src\radioFactory;src\lang;src\trdos;src\utils;Include;include\Core;include\System;include\Protocols;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_UsePackage>rtl;fmx;$(DCC_UsePackage)</DCC_UsePackage>
        <SanitizedProjectName>tr4w</SanitizedProjectName>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;FMX;$(DCC_Namespace)</DCC_Namespace>
        <VerInfo_Keys>CompanyName=;FileDescription=;FileVersion=1.0.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProductName=;ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
        <Icon_MainIcon>$(BDS)\bin\delphi_PROJECTICON.ico</Icon_MainIcon>
        <Icns_MainIcns>$(BDS)\bin\delphi_PROJECTICNS.icns</Icns_MainIcns>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <DCC_Namespace>System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Bde;$(DCC_Namespace)</DCC_Namespace>
        <BT_BuildType>Debug</BT_BuildType>
        <VerInfo_Keys>CompanyName=;FileDescription=$(MSBuildProjectName);FileVersion=1.0.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProductName=$(MSBuildProjectName);ProductVersion=1.0.0.0;Comments=;ProgramID=com.embarcadero.$(MSBuildProjectName)</VerInfo_Keys>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <Icon_MainIcon>tr4w_Icon.ico</Icon_MainIcon>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <Icon_MainIcon>tr4w_Icon.ico</Icon_MainIcon>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>RELEASE;$(ExtraDefines);$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>DEBUG;$(ExtraDefines);$(DCC_Define)</DCC_Define>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_RangeChecking>false</DCC_RangeChecking>
        <DCC_IntegerOverflowCheck>false</DCC_IntegerOverflowCheck>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_OSX64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_OSXARM64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_Win32)'!=''">
